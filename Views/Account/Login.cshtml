@model MvcMovie2.Models.LoginViewModel
@{
    ViewBag.Title = "로그인";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* 로그인 페이지 전용 스타일 */
    .login-card {
        border: none;
        border-radius: 15px; /* 둥근 모서리 */
        box-shadow: 0 10px 30px rgba(0,0,0,0.08); /* 은은한 그림자 */
    }

    .form-control:focus {
        border-color: #000; /* 포커스 시 테두리 검정 */
        box-shadow: 0 0 0 0.2rem rgba(0,0,0,0.1); /* 포커스링 회색 */
    }

    .btn-black {
        background-color: #000;
        color: #fff;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-black:hover {
            background-color: #333; /* 호버 시 약간 연하게 */
            color: #fff;
            transform: translateY(-2px); /* 살짝 위로 */
        }

    .login-icon {
        font-size: 3rem;
        margin-bottom: 20px;
    }
</style>

<div class="container mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card login-card bg-white p-4">
                <div class="card-body">

                    <div class="text-center mb-4">
                        <div class="login-icon text-dark">
                            <i class="fas fa-user-circle"></i>
                        </div>
                        <h3 class="fw-bold mb-1">Welcome Back</h3>
                        <p class="text-muted small">내 영화 컬렉션에 오신 것을 환영합니다.</p>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.UserId, new { @class = "form-control", id = "floatingInput", placeholder = "아이디" })
                            <label for="floatingInput" class="text-secondary">아이디</label>
                        </div>

                        <div class="form-floating mb-4">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", id = "floatingPassword", placeholder = "비밀번호" })
                            <label for="floatingPassword" class="text-secondary">비밀번호</label>
                        </div>

                        <button type="submit" class="btn btn-black btn-lg w-100 py-3 fw-bold">
                            로그인
                        </button>
                    }
                    <div class="text-center mt-4 pt-3 border-top">
                        <p class="text-muted small mb-0">테스트 계정</p>
                        <span class="badge bg-light text-dark border">admin / 1234</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>