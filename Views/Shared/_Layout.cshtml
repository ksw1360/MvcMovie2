<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My Movie List</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        /* 전체적인 폰트와 배경 설정 (완전한 다크 모드) */
        body {
            font-family: 'Pretendard', 'Segoe UI', sans-serif; /* 가독성 좋은 폰트 우선 */
            background-color: #141414; /* 넷플릭스 배경색 */
            color: #e5e5e5;
            padding-top: 80px; /* 네비게이션 높이만큼 여백 */
        }

        /* 네비게이션 바 - 반투명 유리 효과 */
        .navbar {
            background-color: rgba(0, 0, 0, 0.8) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .navbar-brand {
            font-weight: 700;
            color: #fff !important;
            letter-spacing: -0.5px;
        }

        .nav-link {
            color: #b3b3b3 !important;
            font-weight: 500;
            transition: color 0.3s;
        }

            .nav-link:hover, .nav-link.active {
                color: #fff !important;
            }

        /* 공통 버튼 스타일 - 색상 빼고 라인만 */
        .btn-minimal {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: #fff;
            transition: all 0.3s ease;
        }

            .btn-minimal:hover {
                border-color: #fff;
                background: rgba(255, 255, 255, 0.1);
                color: #fff;
            }

        /* 모달 스타일 - 어둡고 심플하게 */
        .modal-content {
            background-color: #1f1f1f;
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .modal-header {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .modal-footer {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-close {
            filter: invert(1) grayscale(100%) brightness(200%);
        }

        footer {
            margin-top: 80px;
            padding: 40px 0;
            color: #666;
            font-size: 0.9rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Movies")">
                <i class="fas fa-film me-2"></i>My Movie List
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link me-3" href="@Url.Action("Index", "Home")">Home</a></li>

                    <li class="nav-item">
                        <a class="nav-link me-3" href="#" data-bs-toggle="modal" data-bs-target="#aboutModal">About</a>
                    </li>

                    <li class="nav-item"><a class="nav-link me-3" href="@Url.Action("Board", "Movies")">Board</a></li>

                    <li class="nav-item">
                        <a class="btn btn-minimal btn-sm px-3" href="@Url.Action("Index", "Movies")">
                            내 컬렉션
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()

        <footer>
            <div class="text-center">
                <p class="mb-0">© @DateTime.Now.Year My Movie List. All rights reserved.</p>
                <p class="small text-muted mt-1">Designed by 김상우</p>
            </div>
        </footer>
    </div>

    <div class="modal fade" id="aboutModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">About</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-5">
                    <div class="mb-4">
                        <i class="fas fa-user-circle fa-4x text-muted mb-3"></i>
                        <h3 class="fw-bold">김상우</h3>
                        <p class="text-muted">Developer</p>
                    </div>

                    <div class="d-flex justify-content-center gap-4 text-start d-inline-block">
                        <div>
                            <span class="d-block text-muted small">CONTACT</span>
                            <span>010-6259-2887</span>
                        </div>
                        <div>
                            <span class="d-block text-muted small">PROJECT</span>
                            <span>Movie Collection App</span>
                        </div>
                    </div>

                    <div class="mt-5 px-4">
                        <p class="text-muted" style="font-size: 0.95rem; line-height: 1.6;">
                            "기록하지 않으면 사라지는 감동을 위해,<br>나만의 영화관을 만들었습니다."
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if (TempData["Msg"] != null)
    {
        <script>
            alert('@TempData["Msg"]');
        </script>
    }
</body>
</html>