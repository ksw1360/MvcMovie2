@model IEnumerable<MvcMovie2.Models.Board>

@{
    ViewBag.Title = "우리 신나게 떠들어봐요~";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* 게시판 전용 스타일 */
    .board-header {
        display: flex;
        justify-content: space-between;
        align-items: end;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .board-title {
        font-size: 2rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 0;
    }

    .board-subtitle {
        color: #666;
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    /* 테이블 스타일 */
    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 0.5rem;
    }

        .custom-table thead th {
            color: #666;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 1rem;
            border: none;
            text-align: center;
        }

            .custom-table thead th.text-start {
                text-align: left;
            }

        .custom-table tbody tr {
            background-color: rgba(255, 255, 255, 0.03);
            transition: all 0.2s ease;
        }

            .custom-table tbody tr.data-row:hover {
                background-color: rgba(255, 255, 255, 0.08);
                transform: scale(1.005);
            }
        /* 데이터 줄만 호버 효과 */
        .custom-table td {
            padding: 1.2rem 1rem;
            vertical-align: middle;
            border: none;
            color: #b3b3b3;
        }

            .custom-table td:first-child {
                border-top-left-radius: 8px;
                border-bottom-left-radius: 8px;
            }

            .custom-table td:last-child {
                border-top-right-radius: 8px;
                border-bottom-right-radius: 8px;
            }

    .post-link {
        color: #fff;
        text-decoration: none;
        font-size: 1.05rem;
        font-weight: 500;
        display: block;
        width: 100%;
    }

        .post-link:hover {
            color: #46d369;
        }

    .writer-badge {
        font-size: 0.9rem;
        color: #888;
        display: flex;
        align-items: center;
        gap: 6px;
        justify-content: center;
    }

    .meta-info {
        font-size: 0.85rem;
        color: #555;
    }

    /* 모달 스타일 */
    .modal-content {
        background-color: #1f1f1f;
        color: #fff;
        border: 1px solid #333;
    }

    .form-control-dark {
        background-color: #2b2b2b;
        border: 1px solid #444;
        color: #fff;
    }

        .form-control-dark:focus {
            background-color: #333;
            color: #fff;
            border-color: #46d369;
        }

    .btn-close-white {
        filter: invert(1);
    }
</style>

<div class="container py-5">

    <div class="board-header">
        <div>
            <h2 class="board-title">Community</h2>
            <p class="board-subtitle">영화에 대한 자유로운 이야기를 나눠보세요.</p>
        </div>
        <div>
            <button type="button" class="btn btn-outline-light px-4" data-bs-toggle="modal" data-bs-target="#writeModal">
                <i class="fas fa-pen me-2"></i> 글쓰기
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th style="width: 8%">No.</th>
                    <th class="text-start">Title</th>
                    <th style="width: 15%">Writer</th>
                    <th style="width: 15%">Date</th>
                    <th style="width: 10%">Views</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <i class="far fa-comments fa-3x mb-3 text-secondary"></i>
                            <p class="text-muted mb-0">아직 등록된 게시글이 없습니다.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr class="data-row">
                            <td class="text-center text-secondary">@item.BoardId</td>
                            <td>
                                <a href="@Url.Action("Details", new { id = item.BoardId })" class="post-link">
                                    @item.Title
                                    @if (item.RegDate >= DateTime.Now.AddDays(-1))
                                    {
                                        <span class="badge bg-danger ms-2" style="font-size:0.6rem; vertical-align: text-top;">N</span>
                                    }
                                </a>
                            </td>
                            <td>
                                <div class="writer-badge">
                                    <i class="fas fa-user-circle"></i> @item.Writer
                                </div>
                            </td>
                            <td class="text-center meta-info">@item.RegDate.ToString("yyyy.MM.dd")</td>
                            <td class="text-center meta-info">
                                <i class="far fa-eye me-1"></i> @item.ViewCount
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>

<div class="modal fade" id="writeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-pen-fancy me-2"></i> 새 글 작성</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            @using (Html.BeginForm("Create", "Board", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <input type="text" name="Writer" class="form-control form-control-dark" placeholder="작성자 (닉네임)" required>
                    </div>
                    <div class="mb-3">
                        <input type="text" name="Title" class="form-control form-control-dark" placeholder="제목을 입력하세요" required>
                    </div>
                    <div class="mb-3">
                        <textarea name="Content" class="form-control form-control-dark" rows="8" placeholder="내용을 입력하세요..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
                    <button type="submit" class="btn btn-success px-4 fw-bold">등록하기</button>
                </div>
            }
        </div>
    </div>
</div>