@model MvcMovie.Models.Board

@{
    ViewBag.Title = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* 상세 페이지 전용 스타일 */
    .post-container {
        max-width: 900px;
        margin: 0 auto;
        background-color: #1f1f1f; /* 카드 배경 */
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        overflow: hidden;
        border: 1px solid #333;
    }

    .post-header {
        padding: 2.5rem 3rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        background: linear-gradient(to bottom, #252525, #1f1f1f);
    }

    .post-title {
        font-size: 2.2rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 1rem;
        line-height: 1.3;
    }

    .post-meta {
        display: flex;
        align-items: center;
        gap: 20px;
        color: #888;
        font-size: 0.95rem;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .post-body {
        padding: 3rem;
        min-height: 300px; /* 내용이 짧아도 폼나게 */
        color: #e0e0e0;
        font-size: 1.1rem;
        line-height: 1.8;
        white-space: pre-wrap; /* 줄바꿈 엔터 적용 */
    }

    .post-footer {
        padding: 1.5rem 3rem;
        background-color: #1a1a1a;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* 버튼 스타일 */
    .btn-action {
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.2s;
    }

    .btn-list {
        background-color: #333;
        color: #ccc;
        border: 1px solid #444;
    }

        .btn-list:hover {
            background-color: #444;
            color: #fff;
        }

    .btn-edit {
        background-color: #0066cc;
        color: white;
        border: none;
    }

        .btn-edit:hover {
            background-color: #0056b3;
            transform: translateY(-2px);
        }

    .btn-delete {
        background-color: transparent;
        color: #dc3545;
        border: 1px solid #dc3545;
    }

        .btn-delete:hover {
            background-color: #dc3545;
            color: white;
        }
</style>

<div class="container py-5">

    <div class="post-container">
        <div class="post-header">
            <h1 class="post-title">@Model.Title</h1>

            <div class="post-meta">
                <div class="meta-item">
                    <i class="fas fa-user-circle fa-lg"></i>
                    <span>@Model.Writer</span>
                </div>
                <div class="meta-item">
                    <i class="far fa-calendar-alt"></i>
                    <span>@Model.RegDate.ToString("yyyy.MM.dd HH:mm")</span>
                </div>
                <div class="meta-item ms-auto">
                    <i class="far fa-eye"></i>
                    <span>@Model.ViewCount 읽음</span>
                </div>
            </div>
        </div>

        <div class="post-body">
            @Model.Content
        </div>

        <div class="post-footer">
            <a href="@Url.Action("Index")" class="btn btn-action btn-list">
                <i class="fas fa-arrow-left me-2"></i> 목록으로
            </a>

            <div class="d-flex gap-2">
                <a href="@Url.Action("Edit", new { id = Model.BoardId })" class="btn btn-action btn-edit text-decoration-none">
                    <i class="fas fa-pen me-2"></i> 수정
                </a>
                <a href="@Url.Action("Delete", new { id = Model.BoardId })" class="btn btn-action btn-delete text-decoration-none"
                   onclick="return confirm('정말 삭제하시겠습니까?');">
                    <i class="fas fa-trash me-2"></i> 삭제
                </a>
            </div>
        </div>
    </div>

</div>