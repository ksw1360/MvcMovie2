@model IEnumerable<MvcMovie2.Models.Movie>

@{
    ViewBag.Title = "내 영화 컬렉션";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* 영화 카드 스타일 (박스 배경 제거) */
    .movie-item {
        background: transparent;
        border: none;
        transition: transform 0.3s ease;
    }

    .movie-item:hover {
        transform: translateY(-5px); /* 살짝 위로 뜸 */
    }

    /* 포스터 컨테이너 */
    .poster-wrapper {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        aspect-ratio: 2 / 3; /* 포스터 비율 고정 */
        background-color: #2f2f2f; /* 이미지가 없을 때 배경 */
        box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    }

    .poster-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
        opacity: 0.9;
    }

    /* 호버 시 이미지 확대 및 밝아짐 */
    .movie-item:hover .poster-img {
        transform: scale(1.05);
        opacity: 1;
    }

    /* 이미지가 없을 때 */
    .no-poster {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
        font-size: 0.9rem;
        flex-direction: column;
    }

    /* 텍스트 정보 스타일 */
    .movie-info {
        padding-top: 12px;
    }

    .movie-title {
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis; /* 긴 제목 ... 처리 */
        text-decoration: none;
        display: block;
    }

    .movie-meta {
        color: #808080;
        font-size: 0.85rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .rating-star {
        color: #ffd700; /* 금색 별 */
        margin-right: 4px;
    }
    
    /* 헤더 스타일 */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: end;
        margin-bottom: 30px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 15px;
    }
</style>

<div class="container py-4">
    
    <div class="page-header">
        <div>
            <h2 class="fw-bold mb-0">Collections</h2>
            <p class="text-muted small mb-0">총 @Model.Count()편의 영화</p>
        </div>
        <div>
            <a href="/Movies/Create" class="btn btn-minimal btn-sm">
                <i class="fas fa-plus me-1"></i> 영화 추가
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-film fa-3x mb-3" style="opacity: 0.3;"></i>
            <p>보관된 영화가 없습니다.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
            @foreach (var movie in Model)
            {
                <div class="col">
                    <div class="movie-item">
                        <a href="/Movies/Details/@movie.ID" class="text-decoration-none">
                            
                            <div class="poster-wrapper">
                                @if (!string.IsNullOrEmpty(movie.PosterURL))
                                {
                                    <img src="@movie.PosterURL" class="poster-img" alt="@movie.Title" 
                                         onerror="this.onerror=null; this.src=''; this.parentElement.innerHTML='<div class=\'no-poster\'><i class=\'fas fa-image fa-2x mb-2\'></i><span>No Image</span></div>';">
                                }
                                else
                                {
                                    <div class="no-poster">
                                        <i class="fas fa-video fa-2x mb-2"></i>
                                        <span>@movie.Title</span>
                                    </div>
                                }
                            </div>

                            <div class="movie-info">
                                <h5 class="movie-title" title="@movie.Title">@movie.Title</h5>
                                
                                <div class="movie-meta">
                                    <span>
                                        @if (movie.Year.HasValue)
                                        {
                                            @movie.Year
                                        }
                                        else
                                        {
                                            <span class="small">-</span>
                                        }
                                    </span>

                                    <span>
                                        @if (movie.Rating.HasValue)
                                        {
                                            <i class="fas fa-star rating-star small"></i> @movie.Rating.Value
                                        }
                                    </span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>