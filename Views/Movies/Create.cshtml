@model MvcMovie.Models.Movie

@{
    ViewBag.Title = "새 영화 등록";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<style>
    body {
        background: #fff;
        color: #222;
        padding: 2rem 0;
    }

    .create-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2.5rem;
        background: #fff;
    }

    h2 {
        font-weight: 800;
        color: #111;
        margin-bottom: 2rem;
        text-align: center;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .form-group {
        margin-bottom: 0;
    }

    label {
        font-weight: 700;
        color: #0066cc;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control, .form-select {
        border-radius: 8px;
        padding: 0.75rem 1rem;
        border: 1px solid #ced4da;
    }

        .form-control:focus {
            border-color: #0066cc;
            box-shadow: 0 0 0 0.2rem rgba(0,102,204,0.15);
        }

    .poster-preview {
        width: 100%;
        max-width: 300px;
        margin: 1rem auto;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        display: block;
    }

    .no-poster-preview {
        width: 300px;
        height: 444px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        border-radius: 12px;
        color: white;
        font-size: 1.8rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        margin: 1rem auto;
    }

    .btn-group {
        justify-content: center;
        margin-top: 3rem;
        gap: 1rem;
    }

    .btn-submit {
        background: #28a745;
        border: none;
        padding: 0.9rem 2.5rem;
        font-size: 1.1rem;
        font-weight: 700;
        border-radius: 50px;
    }

    .btn-cancel {
        background: #6c757d;
        border: none;
        padding: 0.9rem 2rem;
        border-radius: 50px;
    }
</style>

<div class="container create-container">
    <h2><i class="fas fa-plus-circle text-success"></i> 새 영화 등록하기</h2>

    @using (Html.BeginForm("Create", "Movies", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <!-- 첫 번째 열 -->
            <div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Title, "영화 제목")
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", required = "required", placeholder = "예: 인셉션" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.PosterURL, "포스터 URL")
                    @Html.TextBoxFor(m => m.PosterURL, new { @class = "form-control", placeholder = "https://image.tmdb.org/t/p/original/..." })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Genre, "장르")
                    @Html.TextBoxFor(m => m.Genre, new { @class = "form-control", placeholder = "액션, SF, 드라마" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Director, "감독")
                    @Html.TextBoxFor(m => m.Director, new { @class = "form-control", placeholder = "크리스토퍼 놀란" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.LeadActor, "주연 배우")
                    @Html.TextBoxFor(m => m.LeadActor, new { @class = "form-control", placeholder = "레오나르도 디카프리오" })
                </div>
            </div>

            <!-- 두 번째 열 -->
            <div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Year, "개봉 연도")
                    @Html.TextBoxFor(m => m.Year, new { @class = "form-control", type = "number", min = "1900", max = "2030", placeholder = "2025" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Runtime, "상영 시간 (분)")
                    @Html.TextBoxFor(m => m.Runtime, new { @class = "form-control", type = "number", placeholder = "148" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Country, "국가")
                    @Html.TextBoxFor(m => m.Country, new { @class = "form-control", placeholder = "미국, 한국" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Language, "언어")
                    @Html.TextBoxFor(m => m.Language, new { @class = "form-control", placeholder = "영어, 한국어" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Size, "파일 크기 (바이트)")
                    @Html.TextBoxFor(m => m.Size, new { @class = "form-control", type = "number", placeholder = "12345678900" })
                </div>
            </div>

            <!-- 세 번째 열 (긴 입력) -->
            <div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Plot, "줄거리")
                    @Html.TextAreaFor(m => m.Plot, new { @class = "form-control", rows = "6", placeholder = "영화에 대한 간단한 설명을 입력하세요..." })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Budget, "제작비 (달러)")
                    @Html.TextBoxFor(m => m.Budget, new { @class = "form-control", type = "number", placeholder = "200000000" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Revenue, "수익 (달러)")
                    @Html.TextBoxFor(m => m.Revenue, new { @class = "form-control", type = "number", placeholder = "836800000" })
                </div>
            </div>
        </div>

        <!-- 포스터 미리보기 -->
        <div class="text-center mt-4">
            <img id="posterPreview" src="" class="poster-preview" style="display:none;" alt="포스터 미리보기" />
            <div id="noPosterPreview" class="no-poster-preview">포스터 없음</div>
        </div>

        <div class="btn-group d-flex">
            <button type="submit" class="btn btn-success btn-submit">
                등록하기
            </button>
            <a href="@Url.Action("Index")" class="btn btn-secondary btn-cancel">
                취소
            </a>
        </div>
    }
</div>

<script>
    // 포스터 URL 입력 시 실시간 미리보기
    document.querySelector('#PosterURL').addEventListener('input', function () {
        const url = this.value.trim();
        const img = = document.getElementById('posterPreview');
        const noImg = document.getElementById('noPosterPreview');

        if (url && url.startsWith('http')) {
            img.src = url;
            img.style.display = 'block';
            noImg.style.display = 'none';
            img.onerror = () => {
                img.style.display = 'none';
                noImg.style.display = 'flex';
                noImg.textContent = '이미지를 불러올 수 없음';
            };
        } else {
            img.style.display = 'none';
            noImg.style.display = 'flex';
            noImg.textContent = '포스터 없음';
        }
    });
</script>