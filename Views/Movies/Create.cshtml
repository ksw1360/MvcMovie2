@model MvcMovie2.Models.Movie

@{
    ViewBag.Title = "새 영화 등록";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* 다크 모드 입력 폼 스타일 */
    .form-label {
        color: #b3b3b3;
        font-size: 0.85rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-control {
        background-color: #2b2b2b;
        border: 1px solid #404040;
        color: #fff;
        border-radius: 6px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            background-color: #333;
            border-color: #fff; /* 포커스 시 흰색 테두리 */
            color: #fff;
            box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.1);
        }

        .form-control::placeholder {
            color: #666;
            font-size: 0.9rem;
        }

    /* 포스터 미리보기 영역 스타일 */
    .poster-preview-card {
        background-color: #1f1f1f;
        border-radius: 12px;
        overflow: hidden;
        border: 1px dashed #444;
        aspect-ratio: 2/3;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        transition: all 0.3s ease;
    }

    .poster-preview-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none; /* 기본 숨김 */
    }

    .poster-placeholder {
        text-align: center;
        color: #555;
    }

    .sticky-sidebar {
        position: sticky;
        top: 100px; /* 스크롤 시 상단 고정 */
    }

    /* 섹션 구분선 */
    .form-section-title {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 700;
        margin-top: 2rem;
        margin-bottom: 1rem;
        border-bottom: 1px solid #333;
        padding-bottom: 0.5rem;
    }
</style>

<div class="container py-5">

    <div class="d-flex align-items-center justify-content-between mb-5">
        <h2 class="fw-bold text-white mb-0">New Movie</h2>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-times me-1"></i> 취소
        </a>
    </div>

    @using (Html.BeginForm("Create", "Movies", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="row g-5">
            <div class="col-lg-4">
                <div class="sticky-sidebar">
                    <div class="form-label mb-2">Poster Preview</div>

                    <div class="poster-preview-card" id="previewContainer">
                        <img id="posterImg" src="" class="poster-preview-img" alt="Poster Preview">

                        <div class="poster-placeholder" id="posterPlaceholder">
                            <i class="fas fa-image fa-3x mb-3"></i>
                            <p class="mb-0 small">포스터 URL을 입력하면<br>여기에 미리보기가 표시됩니다.</p>
                        </div>
                    </div>

                    <div class="mt-3">
                        @Html.LabelFor(m => m.PosterURL, "포스터 URL", new { @class = "form-label text-warning" })
                        @Html.TextBoxFor(m => m.PosterURL, new { @class = "form-control", placeholder = "https://image.tmdb.org/..." })
                        <div class="form-text text-muted small mt-1">
                            * 타 사이트의 이미지 주소를 복사해서 붙여넣으세요.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">

                <div class="form-section-title mt-0">Basic Info</div>
                <div class="mb-4">
                    @Html.LabelFor(m => m.Title, "영화 제목", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control form-control-lg", required = "required", placeholder = "영화 제목을 입력하세요" })
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Genre, "장르", new { @class = "form-label" })
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fas fa-tags"></i></span>
                            @Html.TextBoxFor(m => m.Genre, new { @class = "form-control", placeholder = "액션, SF, 드라마" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Year, "개봉 연도", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Year, new { @class = "form-control", type = "number", placeholder = DateTime.Now.Year.ToString() })
                    </div>
                </div>

                <div class="form-section-title">Details</div>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Director, "감독", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Director, new { @class = "form-control", placeholder = "감독 이름" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.LeadActor, "주연 배우", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.LeadActor, new { @class = "form-control", placeholder = "주연 배우 이름" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Runtime, "상영 시간 (분)", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Runtime, new { @class = "form-control", type = "number", placeholder = "분 단위 입력" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Country, "국가", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Country, new { @class = "form-control", placeholder = "제작 국가" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Language, "언어", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Language, new { @class = "form-control", placeholder = "주요 언어" })
                    </div>
                </div>

                <div class="form-section-title">Plot</div>
                <div class="mb-4">
                    @Html.TextAreaFor(m => m.Plot, new { @class = "form-control", rows = "5", placeholder = "영화의 줄거리를 입력하세요..." })
                </div>

                <div class="form-section-title">Statistics (Optional)</div>
                <div class="row g-3 mb-5">
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Budget, "제작비 ($)", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Budget, new { @class = "form-control", type = "number", placeholder = "0" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Revenue, "수익 ($)", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Revenue, new { @class = "form-control", type = "number", placeholder = "0" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Size, "파일 크기 (Byte)", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Size, new { @class = "form-control", type = "number", placeholder = "0" })
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-light btn-lg px-5 fw-bold">
                        <i class="fas fa-check me-2"></i> 등록 완료
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const urlInput = document.getElementById('PosterURL');
        const img = document.getElementById('posterImg');
        const placeholder = document.getElementById('posterPlaceholder');
        const container = document.getElementById('previewContainer');

        function updatePreview() {
            const url = urlInput.value.trim();

            if (url && url.startsWith('http')) {
                img.src = url;
                img.style.display = 'block';
                placeholder.style.display = 'none';
                container.style.border = 'none'; // 이미지가 있으면 테두리 제거

                img.onerror = function () {
                    img.style.display = 'none';
                    placeholder.style.display = 'block';
                    container.style.border = '1px dashed #444';
                };
            } else {
                img.style.display = 'none';
                placeholder.style.display = 'block';
                container.style.border = '1px dashed #444';
            }
        }

        // 입력할 때마다 실행
        urlInput.addEventListener('input', updatePreview);

        // 페이지 로드 시 값이 있으면 실행 (수정 모드 대비)
        if (urlInput.value) updatePreview();
    });
</script>