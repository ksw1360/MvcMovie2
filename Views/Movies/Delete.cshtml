@model MvcMovie.Models.Movie

@{
    ViewBag.Title = Model.Title + " - 상세정보";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<style>
    body {
        background: #ffffff;
        color: #222;
    }

    .detail-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 2rem;
    }

    .poster-big {
        width: 100%;
        max-width: 380px;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        border: 1px solid #e0e0e0;
    }

    .no-poster {
        width: 380px;
        height: 560px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2.2rem;
        font-weight: 700;
        text-align: center;
        padding: 20px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }

    .title-main {
        font-size: 3rem;
        font-weight: 800;
        color: #111;
        margin-bottom: 0.5rem;
    }

    .title-sub {
        font-size: 1.4rem;
        color: #555;
        margin-bottom: 1.5rem;
    }

    .rating-big {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #222;
        color: white;
        padding: 10px 24px;
        border-radius: 50px;
        font-size: 1.4rem;
        font-weight: bold;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
        margin: 2.5rem 0;
    }

    .info-item {
        background: #f8f9fa;
        padding: 1.2rem 1.5rem;
        border-radius: 10px;
        border-left: 4px solid #0066cc;
    }

    .info-label {
        font-weight: 700;
        color: #0066cc;
        font-size: 0.95rem;
        margin-bottom: 0.5rem;
    }

    .info-value {
        font-size: 1.1rem;
        color: #333;
    }

    .plot {
        background: #f8f9fa;
        padding: 1.8rem;
        border-radius: 12px;
        line-height: 1.8;
        font-size: 1.1rem;
        border-left: 4px solid #28a745;
    }

    .btn-group .btn {
        border-radius: 8px;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
    }

    .btn-back {
        background: #666;
        color: white;
    }

    .btn-edit {
        background: #0066cc;
        color: white;
    }

    .btn-delete {
        background: #dc3545;
        color: white;
    }
</style>

<div class="detail-container">
    <div class="row g-5">
        <!-- 포스터 -->
        <div class="col-lg-4 text-center">
            @if (!string.IsNullOrEmpty(Model.PosterURL))
            {
                <img src="@Model.PosterURL" class="poster-big" alt="@Model.Title"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <div class="no-poster d-none">
                    @Model.Title
                </div>
            }
            else
            {
                <div class="no-poster">@Model.Title</div>
            }
        </div>

        <!-- 상세 정보 -->
        <div class="col-lg-8">
            <h1 class="title-main">@Model.Title</h1>
            <p class="title-sub">
                @if (!string.IsNullOrEmpty(Model.Director))
                {
                    <span>@Model.Director 감독</span>
                }
                @if (Model.Year.HasValue)
                {
                    <span> • @Model.Year</span>
                }
            </p>

            @if (Model.Rating.HasValue)
            {
                <div class="rating-big">
                    <i class="fas fa-star text-warning"></i> @Model.Rating / 10
                </div>
            }

            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">장르</div>
                    <div class="info-value">@(Model.Genre ?? "미정")</div>
                </div>
                <div class="info-item">
                    <div class="info-label">주연</div>
                    <div class="info-value">@(Model.LeadActor ?? "미정")</div>
                </div>
                <div class="info-item">
                    <div class="info-label">상영시간</div>
                    <div class="info-value">@(Model.Runtime.HasValue ? Model.Runtime + "분" : "미정")</div>
                </div>
                <div class="info-item">
                    <div class="info-label">개봉일</div>
                    <div class="info-value">@(Model.ReleaseDate.HasValue ? Model.ReleaseDate.Value.ToString("yyyy년 MM월 dd일") : "미정")</div>
                </div>
                <div class="info-item">
                    <div class="info-label">국가</div>
                    <div class="info-value">@(Model.Country ?? "미정")</div>
                </div>
                <div class="info-item">
                    <div class="info-label">언어</div>
                    <div class="info-value">@(Model.Language ?? "미정")</div>
                </div>
                @if (Model.Budget.HasValue || Model.Revenue.HasValue)
                {
                    <div class="info-item">
                        <div class="info-label">제작비 / 수익</div>
                        <div class="info-value">
                            @(Model.Budget.HasValue ? "$" + string.Format("{0:N0}", Model.Budget) : "미정")<br>
                            @(Model.Revenue.HasValue ? "$" + string.Format("{0:N0}", Model.Revenue) : "미정")
                        </div>
                    </div>
                }
                <div class="info-item">
                    <div class="info-label">파일 크기</div>
                    <div class="info-value">
                        @(Model.Size.HasValue ? ((double)Model.Size / 1024 / 1024 / 1024).ToString("F1") + " GB" : "미정")
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Plot))
            {
                <h3 class="mt-5 mb-3" style="color:#28a745; font-weight:700;">줄거리</h3>
                <div class="plot">@Model.Plot</div>
            }

            <!-- 버튼 영역만 교체하세요 -->
            <div class="mt-5 btn-group btn-group-lg" role="group">
                <a href="@Url.Action("Index")" class="btn btn-link text-dark fw-semibold me-4">
                    ← 목록으로
                </a>
                <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-link text-primary fw-semibold me-4">
                    수정하기
                </a>
                <a href="@Url.Action("Delete", new { id = Model.ID })" class="btn btn-link text-danger fw-semibold"
                   onclick="return confirm('정말 삭제하시겠습니까?');">
                    삭제하기
                </a>
            </div>
        </div>
    </div>
</div>