@model dynamic

@{
    ViewBag.Title = "About";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-gradient-to-br from-gray-900 via-purple-900 to-black flex items-center justify-center px-6">
    <div class="max-w-2xl w-full bg-white bg-opacity-95 rounded-3xl shadow-2xl overflow-hidden transform hover:scale-105 transition duration-500">
        <!-- 헤더 -->
        <div class="bg-gradient-to-r from-purple-600 to-pink-600 text-white p-10 text-center">
            <h1 class="text-5xl font-extrabold mb-3 tracking-wider">About This App</h1>
            <p class="text-xl opacity-90">내 영화 컬렉션 관리 시스템</p>
        </div>

        <!-- 본문 -->
        <div class="p-10 space-y-8 text-gray-800">
            <div class="text-center">
                <div class="inline-block p-6 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full text-white text-6xl font-bold shadow-lg">
                    K
                </div>
                <h2 class="text-3xl font-bold mt-4">제작자</h2>
                <p class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-pink-600 mt-2">
                    김상우
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-lg">
                <div class="bg-gray-50 p-6 rounded-2xl border-l-8 border-purple-600">
                    <p class="font-bold text-purple-700 mb-2">연락처</p>
                    <p class="text-2xl font-mono">010-6259-2887</p>
                </div>
                <div class="bg-gray-50 p-6 rounded-2xl border-l-8 border-pink-600">
                    <p class="font-bold text-pink-700 mb-2">제작 용도</p>
                    <p class="text-xl font-semibold">Asp.Net MVC 학습 프로젝트</p>
                </div>
            </div>

            <div class="text-center">
                <p class="font-bold text-gray-600 mb-2">제작일자</p>
                <p class="text-3xl font-bold text-gray-800">
                    @DateTime.Now.ToString("yyyy년 MM월 dd일")
                </p>
                <p class="text-sm text-gray-500 mt-2">
                    (@DateTime.Now.ToString("yyyy-MM-dd HH:mm") 기준)
                </p>
            </div>

            <!-- 닫기 버튼 -->
            <div class="text-center pt-6">
                <a href="@Url.Action("Index", "Movies")"
                   class="inline-block bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-bold text-xl px-12 py-5 rounded-full shadow-xl transform hover:scale-110 transition duration-300">
                    내 영화 보러가기
                </a>
            </div>
        </div>
    </div>
</div>