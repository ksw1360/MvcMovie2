@model MvcMovie2.Models.Movie

@{
    ViewBag.Title = "영화 정보 수정";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* 다크 모드 입력 폼 스타일 */
    .form-label {
        color: #b3b3b3;
        font-size: 0.85rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-control {
        background-color: #2b2b2b;
        border: 1px solid #404040;
        color: #fff;
        border-radius: 6px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            background-color: #333;
            border-color: #fff;
            color: #fff;
            box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.1);
        }

    /* 포스터 미리보기 카드 */
    .poster-preview-card {
        background-color: #1f1f1f;
        border-radius: 12px;
        overflow: hidden;
        border: 1px dashed #444;
        aspect-ratio: 2/3;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .poster-preview-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none; /* JS로 제어 */
    }

    .poster-placeholder {
        text-align: center;
        color: #555;
    }

    /* 스크롤 시 포스터 고정 */
    .sticky-sidebar {
        position: sticky;
        top: 100px;
    }

    /* 섹션 타이틀 */
    .form-section-title {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 700;
        margin-top: 2rem;
        margin-bottom: 1rem;
        border-bottom: 1px solid #333;
        padding-bottom: 0.5rem;
    }
</style>

<div class="container py-5">

    <div class="d-flex align-items-center justify-content-between mb-5">
        <h2 class="fw-bold text-white mb-0">Edit Movie</h2>
        <a href="@Url.Action("Details", new { id = Model.ID })" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-times me-1"></i> 취소
        </a>
    </div>

    @using (Html.BeginForm("Edit", "Movies", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.ID)

        <div class="row g-5">
            <div class="col-lg-4">
                <div class="sticky-sidebar">
                    <div class="form-label mb-2">Poster Preview</div>

                    <div class="poster-preview-card" id="previewContainer">
                        <img id="posterImg" src="@Model.PosterURL" class="poster-preview-img" alt="Poster Preview">

                        <div class="poster-placeholder" id="posterPlaceholder">
                            <i class="fas fa-image fa-3x mb-3"></i>
                            <p class="mb-0 small">No Image</p>
                        </div>
                    </div>

                    <div class="mt-3">
                        @Html.LabelFor(m => m.PosterURL, "포스터 URL", new { @class = "form-label text-warning" })
                        @Html.TextBoxFor(m => m.PosterURL, new { @class = "form-control", placeholder = "https://image.tmdb.org/..." })
                    </div>
                </div>
            </div>

            <div class="col-lg-8">

                <div class="form-section-title mt-0">Basic Info</div>
                <div class="mb-4">
                    @Html.LabelFor(m => m.Title, "영화 제목", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control form-control-lg", required = "required" })
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Genre, "장르", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Genre, new { @class = "form-control" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Year, "개봉 연도", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Year, new { @class = "form-control", type = "number" })
                    </div>
                </div>

                <div class="form-section-title">Details</div>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Director, "감독", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Director, new { @class = "form-control" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.LeadActor, "주연 배우", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.LeadActor, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Runtime, "상영 시간 (분)", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Runtime, new { @class = "form-control", type = "number" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Country, "국가", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Country, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Language, "언어", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Language, new { @class = "form-control" })
                    </div>
                </div>

                <div class="form-section-title">Plot</div>
                <div class="mb-4">
                    @Html.TextAreaFor(m => m.Plot, new { @class = "form-control", rows = "5" })
                </div>

                <div class="form-section-title">Statistics</div>
                <div class="row g-3 mb-5">
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Budget, "제작비 ($)", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Budget, new { @class = "form-control", type = "number" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Revenue, "수익 ($)", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Revenue, new { @class = "form-control", type = "number" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Size, "파일 크기 (Byte)", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Size, new { @class = "form-control", type = "number" })
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4 me-2">취소</a>
                    <button type="submit" class="btn btn-light btn-lg px-5 fw-bold">
                        <i class="fas fa-save me-2"></i> 수정 저장
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const urlInput = document.getElementById('PosterURL');
        const img = document.getElementById('posterImg');
        const placeholder = document.getElementById('posterPlaceholder');
        const container = document.getElementById('previewContainer');

        function updatePreview() {
            const url = urlInput.value.trim();

            if (url && url.startsWith('http')) {
                img.src = url;
                img.style.display = 'block';
                placeholder.style.display = 'none';
                container.style.border = 'none';

                img.onerror = function () {
                    img.style.display = 'none';
                    placeholder.style.display = 'block';
                    container.style.border = '1px dashed #444';
                };
            } else {
                img.style.display = 'none';
                placeholder.style.display = 'block';
                container.style.border = '1px dashed #444';
            }
        }

        // 입력 시 실행
        urlInput.addEventListener('input', updatePreview);

        // ★ 페이지 로드 시 기존 URL이 있으면 미리보기 실행
        if (urlInput.value) {
            updatePreview();
        }
    });
</script>