@model IEnumerable<MvcMovie.Models.Movie>

@{
    ViewBag.Title = "내 영화 컬렉션";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: #141414;
            color: #fff;
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar {
            background: #000 !important;
        }

        .card {
            background: #221f1f;
            border: none;

            transition:hover {
                transform: translateY(-8px);
                box-shadow: 0 20px 40px rgba(255,69,0,0.4);
            }

            overflow: hidden;
            height: 100%;
        }

        .poster {
            height: 400px;
            object-fit: cover;
            width: 100%;
            border-radius: 8px 8px 0 0;
        }

        .rating-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(0,0,0,0.8);
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 1.1rem;
        }

        .year-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: #e50914;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.9rem;
        }

        .runtime {
            color: #46d369;
            font-weight: bold;
        }

        h1 {
            color: #e50914;
            text-align: center;
            margin: 40px 0;
            font-weight: bold;
        }

        .no-poster {
            height: 400px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2rem;
            border-radius: 8px 8px 0 0;
        }
    </style>
</head>
<body>
    <div class="container py-5">
        <h1>내가 가진 영화들 (@Model.Count()편)</h1>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h3>아직 영화가 없어요</h3>
                <a href="/Movies/Create" class="btn btn-danger btn-lg mt-3">첫 번째 영화 등록하러 가기</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
                @foreach (var movie in Model)
                {
                    <div class="col">
                        <div class="card h-100 text-white">
                            <div class="position-relative">
                                @if (!string.IsNullOrEmpty(movie.PosterURL))
                                {
                                    <img src="@movie.PosterURL" class="poster" alt="@movie.Title" onerror="this.src='https://via.placeholder.com/300x450?text=No+Image'">
                                }
                                else
                                {
                                    <div class="no-poster">
                                        <div>@movie.Title</div>
                                    </div>
                                }

                                @if (movie.Rating.HasValue)
                                {
                                    <div class="rating-badge">
                                        <i class="fas fa-star"></i> @movie.Rating.Value
                                    </div>
                                }

                                @if (movie.Year.HasValue)
                                {
                                    <div class="year-badge">@movie.Year</div>
                                }
                            </div>

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title text-truncate" title="@movie.Title">
                                    @movie.Title
                                </h5>
                                <p class="card-text small text-muted mb-2">
                                    @movie.Director <br>
                                    <strong>@movie.LeadActor</strong>
                                </p>
                                <p class="card-text">
                                    @if (!string.IsNullOrEmpty(movie.Genre))
                                    {
                                        <span class="badge bg-secondary me-1">@movie.Genre</span>
                                    }
                                    @if (movie.Runtime.HasValue)
                                    {
                                        <span class="runtime">@movie.Runtime</span>
                                    }
                                </p>

                                <div class="mt-auto">
                                    <a href="/Movies/Details/@movie.ID" class="btn btn-outline-light btn-sm w-100">
                                        자세히 보기
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</body>
</html>